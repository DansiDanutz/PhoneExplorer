{
  "name": "phoneexplorer",
  "version": "0.1.0",
  "description": "A desktop bridge for your phone — mirror it, browse its app store, install and open apps.",
  "main": "./out/main/index.js",
  "author": "DansiDanutz",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "dist": "electron-vite build && electron-builder",
    "dist:dir": "electron-vite build && electron-builder --dir",
    "shot": "electron-vite build && electron . --demo --screenshot .shots/app.png --screenshot-delay 1800",
    "e2e": "npm run build && node scripts/e2e.mjs",
    "e2e:models": "npm run build && node scripts/e2e-models.mjs",
    "e2e:gestures": "npm run build && node scripts/e2e-gestures.mjs",
    "e2e:library": "npm run build && node scripts/e2e-library.mjs",
    "e2e:artefacts": "npm run build && node scripts/e2e-artefacts.mjs",
    "e2e:real": "npm run build && node scripts/e2e-real.mjs",
    "showcase": "npm run build && node scripts/showcase.mjs",
    "icon": "node scripts/make-icon.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "playwright-core": "^1.65.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/DansiDanutz/PhoneExplorer.git"
  },
  "homepage": "https://github.com/DansiDanutz/PhoneExplorer#readme",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@yume-chan/adb": "^2.6.4",
    "@yume-chan/adb-scrcpy": "^2.3.2",
    "@yume-chan/adb-server-node-tcp": "^2.5.2",
    "@yume-chan/scrcpy": "^2.3.0"
  }
}
